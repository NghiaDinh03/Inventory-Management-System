@{
    ViewData["Title"] = "Demo SQL Server (B1-B5)";
}

<div class="alert alert-info border-info-subtle bg-info-subtle text-info-emphasis p-3 rounded mb-4">
    <div class="d-flex align-items-center gap-3">
        <i class="fa-solid fa-graduation-cap fs-3"></i>
        <div>
            <h5 class="fw-bold mb-1">Môi trường tương tác thực thi Logic nghiệp vụ CSDL (B1 - B5)</h5>
            <p class="mb-0 text-sm" style="font-size: 13px;">
                Màn hình này mô phỏng việc thực thi các cấu trúc cơ sở dữ liệu nâng cao gồm **Stored Procedure, Trigger, Function và Cursor** trực tiếp trên giao diện web qua 5 bước tiêu chuẩn (B1: Kịch bản -> B2: Câu lệnh SQL -> B3: Trạng thái trước chạy -> B4: Hành động -> B5: Trạng thái sau chạy).
            </p>
        </div>
    </div>
</div>

<!-- Navigation Tabs -->
<ul class="nav nav-pills mb-4 gap-2" id="demoTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold py-2 px-4" id="sp-tab" data-bs-toggle="pill" data-bs-target="#panel-sp" type="button" role="tab" onclick="loadBeforeData('GET_BEFORE_SP', 'tbl-sp-before')">
            <i class="fa-solid fa-code me-1"></i> Stored Procedure
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2 px-4" id="trigger-tab" data-bs-toggle="pill" data-bs-target="#panel-trigger" type="button" role="tab" onclick="loadBeforeData('GET_BEFORE_TRIGGER_PASS', 'tbl-trigger-before')">
            <i class="fa-solid fa-bolt me-1"></i> Trigger
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2 px-4" id="func-tab" data-bs-toggle="pill" data-bs-target="#panel-func" type="button" role="tab" onclick="loadBeforeData('GET_BEFORE_FUNCTION', 'tbl-func-before')">
            <i class="fa-solid fa-calculator me-1"></i> Function
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link fw-bold py-2 px-4" id="cursor-tab" data-bs-toggle="pill" data-bs-target="#panel-cursor" type="button" role="tab" onclick="loadBeforeData('GET_BEFORE_CURSOR', 'tbl-cursor-before')">
            <i class="fa-solid fa-arrow-pointer me-1"></i> Cursor
        </button>
    </li>
</ul>

<!-- Tab Contents -->
<div class="tab-content" id="demoTabsContent">
    
    <!-- 1. TAB STORED PROCEDURE -->
    <div class="tab-pane fade show active" id="panel-sp" role="tabpanel">
        <div class="card-custom">
            <!-- B1 -->
            <div class="demo-step">
                <div class="demo-step-title">B1: Kịch bản nghiệp vụ</div>
                <p class="text-secondary" style="font-size: 14px;">
                    Tạo mới phiếu nhập kho ở trạng thái Nháp (TrangThai = N'Nháp'). Thủ tục lưu trữ <code>sp_TaoPhieuNhap</code> nhận các thông tin nhà cung cấp, kho, ghi chú và một danh sách các mặt hàng (truyền vào dưới dạng Table-Valued Parameter). Khi thực thi, thủ tục sẽ tự động chèn vào bảng PhieuNhap và CT_PhieuNhap. Đồng thời, Trigger <code>trg_TaoSoPhieu_PN</code> tự động sinh số phiếu dạng (PN-YYYY-0000X) và Trigger <code>trg_CapNhatTongTien_PN</code> tự động tính tổng tiền phiếu nhập.
                </p>
            </div>

            <!-- B2 -->
            <div class="demo-step">
                <div class="demo-step-title">B2: Định nghĩa truy vấn SQL & Thực thi</div>
                <div class="code-block">
INSERT INTO @@Details (MaSP, SoLuong, DonGia) VALUES (1, 10, 30000); -- Táo Fuji
INSERT INTO @@Details (MaSP, SoLuong, DonGia) VALUES (6, 5, 8000);  -- Cải xanh

EXEC sp_TaoPhieuNhap 
    @@MaNCC = 1, 
    @@MaKho = 1, 
    @@MaNV = 1, 
    @@GhiChu = N'Phiếu nhập tạo thử nghiệm qua Web UI', 
    @@ChiTiet = @@Details;
                </div>
            </div>

            <!-- B3 -->
            <div class="demo-step">
                <div class="demo-step-title">B3: Trạng thái cơ sở dữ liệu hiện tại (Trước khi thực thi)</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-sp-before">
                        <thead><tr><th>Đang tải dữ liệu...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- B4 -->
            <div class="demo-step">
                <div class="demo-step-title">B4: Hành động thực thi</div>
                <button class="btn-custom btn-primary-custom py-2" onclick="runDemo('RUN_SP', 'GET_AFTER_SP', 'tbl-sp-after')">
                    Chạy thủ tục sp_TaoPhieuNhap <i class="fa-solid fa-play"></i>
                </button>
            </div>

            <!-- B5 -->
            <div class="demo-step d-none" id="step-sp-after">
                <div class="demo-step-title">B5: Trạng thái cơ sở dữ liệu (Sau khi thực thi - Tự động sinh số phiếu và tính tổng tiền)</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-sp-after">
                        <thead><tr><th>Đang chờ thực thi...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. TAB TRIGGER -->
    <div class="tab-pane fade" id="panel-trigger" role="tabpanel">
        <div class="card-custom">
            <!-- B1 -->
            <div class="demo-step">
                <div class="demo-step-title">B1: Kịch bản nghiệp vụ</div>
                <p class="text-secondary" style="font-size: 14px;">
                    Kiểm tra và trừ số lượng tồn kho khi duyệt phiếu xuất. Khi người quản lý thực hiện duyệt phiếu xuất (TrangThai = N'ĐãDuyệt'), trigger <code>trg_PhieuXuat_CapNhatTonKho</code> sẽ tự động quét qua các sản phẩm trong phiếu xuất để kiểm tra lượng tồn kho. Nếu đủ hàng, trigger tiến hành trừ số lượng và trọng lượng tồn kho trong bảng <code>TonKho</code>. Nếu thiếu hàng, trigger sẽ báo lỗi (<code>RAISERROR</code>) và <code>ROLLBACK TRANSACTION</code> chặn không cho duyệt phiếu để tránh xuất âm kho.
                </p>
            </div>

            <!-- B2 -->
            <div class="demo-step">
                <div class="demo-step-title">B2: Định nghĩa truy vấn SQL & Thực thi</div>
                <div class="code-block">
-- Duyệt phiếu xuất (kích hoạt kiểm tra tồn kho):
EXEC sp_DuyetPhieu @@LoaiPhieu = 'PX', @@MaPhieu = @@MaPX, @@MaNV = 1;
                </div>
            </div>

            <!-- B3 -->
            <div class="demo-step">
                <div class="demo-step-title">B3: Trạng thái tồn sản phẩm 1 tại Kho 1 (Trước khi xuất)</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-trigger-before">
                        <thead><tr><th>Đang tải dữ liệu...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- B4 -->
            <div class="demo-step">
                <div class="demo-step-title">B4: Hành động thực thi</div>
                <div class="d-flex gap-2">
                    <button class="btn-custom btn-primary-custom py-2" onclick="runDemo('RUN_TRIGGER_PASS', 'GET_AFTER_TRIGGER_PASS', 'tbl-trigger-after')">
                        Duyệt phiếu - ĐỦ TỒN KHO (Xuất 2 cái) <i class="fa-solid fa-check-double"></i>
                    </button>
                    <button class="btn-custom btn-primary-custom py-2" style="background: var(--danger);" onclick="runDemoFail('RUN_TRIGGER_FAIL')">
                        Duyệt phiếu - THIẾU TỒN KHO (Xuất 500 cái) <i class="fa-solid fa-triangle-exclamation"></i>
                    </button>
                </div>
            </div>

            <!-- B5 -->
            <div class="demo-step d-none" id="step-trigger-after">
                <div class="demo-step-title">B5: Trạng thái tồn kho (Sau khi thực thi - Tồn kho giảm đi 2 cái)</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-trigger-after">
                        <thead><tr><th>Đang chờ thực thi...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. TAB FUNCTION -->
    <div class="tab-pane fade" id="panel-func" role="tabpanel">
        <div class="card-custom">
            <!-- B1 -->
            <div class="demo-step">
                <div class="demo-step-title">B1: Kịch bản nghiệp vụ</div>
                <p class="text-secondary" style="font-size: 14px;">
                    Tự động tính toán tổng giá trị tồn kho hiện tại của một kho hàng và giá xuất bình quan của sản phẩm. Hàm vô hướng <code>fn_TinhGiaTriTonKho(@@MaKho)</code> trả về tổng giá trị tiền hàng hiện đang lưu kho. Hàm vô hướng <code>fn_TinhGiaXuatBinhQuan(@@MaSP)</code> tự động quét qua toàn bộ lịch sử các phiếu nhập hàng đã duyệt để tính đơn giá nhập bình quan gia quyền của sản phẩm làm cơ sở tính giá xuất kho.
                </p>
            </div>

            <!-- B2 -->
            <div class="demo-step">
                <div class="demo-step-title">B2: Định nghĩa truy vấn SQL & Thực thi</div>
                <div class="code-block">
SELECT 
    dbo.fn_TinhGiaTriTonKho(1) AS [Tổng giá trị tồn Kho 1 (VND)], 
    dbo.fn_TinhGiaXuatBinhQuan(1) AS [Giá xuất bình quan SP 1 (VND)]
                </div>
            </div>

            <!-- B3 -->
            <div class="demo-step">
                <div class="demo-step-title">B3: Đơn giá nhập và giá bán tham chiếu mặc định của sản phẩm 1 & 2</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-func-before">
                        <thead><tr><th>Đang tải dữ liệu...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- B4 -->
            <div class="demo-step">
                <div class="demo-step-title">B4: Hành động thực thi</div>
                <button class="btn-custom btn-primary-custom py-2" onclick="runDemo('RUN_FUNCTION', 'RUN_FUNCTION', 'tbl-func-after')">
                    Chạy các hàm Function SQL <i class="fa-solid fa-calculator"></i>
                </button>
            </div>

            <!-- B5 -->
            <div class="demo-step d-none" id="step-func-after">
                <div class="demo-step-title">B5: Kết quả tính toán trả về tự động từ các hàm SQL</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-func-after">
                        <thead><tr><th>Đang chờ thực thi...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. TAB CURSOR -->
    <div class="tab-pane fade" id="panel-cursor" role="tabpanel">
        <div class="card-custom">
            <!-- B1 -->
            <div class="demo-step">
                <div class="demo-step-title">B1: Kịch bản nghiệp vụ</div>
                <p class="text-secondary" style="font-size: 14px;">
                    Duyệt qua danh sách sản phẩm cảnh báo tồn thấp bằng Cursor để in thông báo và trả dữ liệu ra ngoài. Mặc dù con trỏ (Cursor) tiêu tốn tài nguyên hệ thống, nhưng nó là giải pháp hữu hiệu phục vụ yêu cầu học thuật và các logic duyệt tuần tự từng dòng để xử lý cảnh báo. Thủ tục <code>sp_CursorCanhBaoTon</code> khai báo cursor, mở cursor, nạp (fetch) từng dòng sản phẩm có lượng tồn dưới ngưỡng tối thiểu, in thông điệp cảnh báo ra cửa sổ Message của SQL Server và trả về bảng dữ liệu cho Web.
                </p>
            </div>

            <!-- B2 -->
            <div class="demo-step">
                <div class="demo-step-title">B2: Định nghĩa truy vấn SQL & Thực thi</div>
                <div class="code-block">
EXEC sp_CursorCanhBaoTon;
                </div>
            </div>

            <!-- B3 -->
            <div class="demo-step">
                <div class="demo-step-title">B3: Danh sách sản phẩm đang dưới ngưỡng tồn tối thiểu cảnh báo</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-cursor-before">
                        <thead><tr><th>Đang tải dữ liệu...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <!-- B4 -->
            <div class="demo-step">
                <div class="demo-step-title">B4: Hành động thực thi</div>
                <button class="btn-custom btn-primary-custom py-2" onclick="runDemo('RUN_CURSOR', 'RUN_CURSOR', 'tbl-cursor-after')">
                    Chạy thủ tục chứa Cursor <i class="fa-solid fa-arrows-spin"></i>
                </button>
            </div>

            <!-- B5 -->
            <div class="demo-step d-none" id="step-cursor-after">
                <div class="demo-step-title">B5: Chi tiết cảnh báo được duyệt và trả về từng dòng bởi Cursor</div>
                <div class="table-responsive">
                    <table class="table table-custom table-hover" id="tbl-cursor-after">
                        <thead><tr><th>Đang chờ thực thi...</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Load B3 data for SP tab on initial load
            loadBeforeData('GET_BEFORE_SP', 'tbl-sp-before');
        });

        // Load before-state data (B3) via AJAX
        function loadBeforeData(actionType, tableId) {
            var tbody = document.getElementById(tableId).getElementsByTagName('tbody')[0];
            var thead = document.getElementById(tableId).getElementsByTagName('thead')[0];
            tbody.innerHTML = '<tr><td class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div> Đang tải dữ liệu...</td></tr>';

            fetch('/Demo/ExecuteDemo', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ actionType: actionType })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success && res.data.length > 0) {
                    renderTable(thead, tbody, res.data);
                } else {
                    tbody.innerHTML = '<tr><td class="text-center text-muted py-3">Không tìm thấy dữ liệu mẫu.</td></tr>';
                }
            });
        }

        // Execute DB action (B4) and retrieve after-state (B5) via AJAX
        function runDemo(runAction, afterAction, tableIdAfter) {
            Swal.fire({
                title: 'Đang thực thi SQL...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading() }
            });

            fetch('/Demo/ExecuteDemo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ actionType: runAction })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    Swal.fire('Thành công', res.message || 'Thực thi SQL thành công!', 'success');

                    // Show step B5
                    var stepAfterId = tableIdAfter.replace('tbl', 'step');
                    var stepDiv = document.getElementById(stepAfterId);
                    if (stepDiv) stepDiv.classList.remove('d-none');

                    // Fetch after-state data
                    if (runAction === 'RUN_FUNCTION' || runAction === 'RUN_CURSOR') {
                        var thead = document.getElementById(tableIdAfter).getElementsByTagName('thead')[0];
                        var tbody = document.getElementById(tableIdAfter).getElementsByTagName('tbody')[0];
                        renderTable(thead, tbody, res.data);
                    } else {
                        loadAfterData(afterAction, tableIdAfter);
                    }
                } else {
                    Swal.fire('Thất bại', res.message, 'error');
                }
            });
        }

        // Execute action that triggers database constraints (Trigger rollback) via AJAX
        function runDemoFail(runAction) {
            Swal.fire({
                title: 'Đang thực thi SQL...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading() }
            });

            fetch('/Demo/ExecuteDemo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ actionType: runAction })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    Swal.fire('Thành công?', 'Tại sao hành động này thành công? Đáng lẽ trigger phải rollback!', 'warning');
                } else {
                    // Display trigger-thrown constraint error
                    Swal.fire({
                        title: 'HỆ THỐNG ĐÃ CHẶN GIAO DỊCH!',
                        html: `<div class="text-danger fw-bold mb-2">Trigger trg_PhieuXuat_CapNhatTonKho đã chặn hành động này:</div><code class="text-dark bg-light p-2 border rounded d-block text-start">${res.message}</code>`,
                        icon: 'error',
                        confirmButtonText: 'Đã hiểu'
                    });
                }
            });
        }

        // Retrieve subsequent modified database state via AJAX
        function loadAfterData(actionType, tableId) {
            var tbody = document.getElementById(tableId).getElementsByTagName('tbody')[0];
            var thead = document.getElementById(tableId).getElementsByTagName('thead')[0];
            tbody.innerHTML = '<tr><td class="text-center py-3">Đang tải dữ liệu kết quả...</td></tr>';

            fetch('/Demo/ExecuteDemo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ actionType: actionType })
            })
            .then(res => res.json())
            .then(res => {
                if (res.success && res.data.length > 0) {
                    renderTable(thead, tbody, res.data);
                } else {
                    tbody.innerHTML = '<tr><td class="text-center text-muted py-3">Không có dữ liệu.</td></tr>';
                }
            });
        }

        // Dynamically render tables from JSON array
        function renderTable(thead, tbody, list) {
            if (!list || list.length === 0) return;
            
            // Render header
            var keys = Object.keys(list[0]);
            var headerHtml = '<tr>';
            keys.forEach(k => {
                headerHtml += `<th>${k}</th>`;
            });
            headerHtml += '</tr>';
            thead.innerHTML = headerHtml;

            // Render body
            var bodyHtml = '';
            list.forEach(row => {
                bodyHtml += '<tr>';
                keys.forEach(k => {
                    var val = row[k];
                    // Format currency if matching key name
                    if (k.toLowerCase().includes('tien') || k.toLowerCase().includes('gia') || k.toLowerCase().includes('doanhthu')) {
                        if (typeof val === 'number') {
                            val = val.toLocaleString('vi-VN') + ' VND';
                        }
                    }
                    bodyHtml += `<td>${val}</td>`;
                });
                bodyHtml += '</tr>';
            });
            tbody.innerHTML = bodyHtml;
        }
    </script>
}
