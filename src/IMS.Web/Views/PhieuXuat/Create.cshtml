@{
    ViewData["Title"] = "Tạo phiếu xuất kho";
    var sanPhams = ViewBag.SanPhams as List<IMS.Web.Models.SanPham> ?? new List<IMS.Web.Models.SanPham>();
}

<div class="card-custom">
    <div class="card-title-custom">
        <span><i class="fa-solid fa-file-export text-primary me-2"></i>Lập phiếu xuất kho mới (Nháp)</span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="phieuXuatForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        
        <!-- General info section -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <label class="form-label-custom">Kho xuất hàng <span class="text-danger">*</span></label>
                <select name="maKho" id="selectKho" class="form-control-custom w-100" asp-items="ViewBag.Khos" onchange="onKhoOrProductChange()" required>
                    <option value="">-- Chọn kho xuất --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label-custom">Người nhận <span class="text-danger">*</span></label>
                <input type="text" name="nguoiNhan" class="form-control-custom w-100" placeholder="Tên người nhận..." required />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label-custom">Ghi chú</label>
                <input type="text" name="ghiChu" class="form-control-custom w-100" placeholder="Ghi chú thêm..." />
            </div>
        </div>

        <hr />

        <!-- Product selection form -->
        <h5 class="font-title fw-bold text-secondary mb-3"><i class="fa-solid fa-cart-plus me-2"></i>Thêm sản phẩm</h5>
        <div class="row g-3 align-items-end mb-4 p-4 rounded-3" style="background-color: #f8fafc; border: 1px dashed var(--primary-light);">
            <div class="col-md-4">
                <label class="form-label-custom">Sản phẩm</label>
                <select id="selectSP" class="form-control-custom w-100" onchange="onKhoOrProductChange()">
                    <option value="">-- Chọn sản phẩm --</option>
                    @foreach (var sp in sanPhams)
                    {
                        <option value="@sp.MaSP" data-gia="@sp.GiaBan" data-dv="@sp.DonVi">@sp.TenSP (@sp.DonVi)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label-custom">Số lượng</label>
                <input type="number" id="inputSL" class="form-control-custom w-100" min="1" value="1" />
            </div>
            <div class="col-md-2">
                <label class="form-label-custom">Đơn giá</label>
                <input type="number" id="inputDG" class="form-control-custom w-100" min="0" value="0" step="500" />
            </div>
            <div class="col-md-2">
                <label class="form-label-custom d-block mb-2">Tồn kho hiện tại</label>
                <span class="badge bg-secondary fs-6 py-2 px-3 d-block text-center" id="lblTonKho">0</span>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn-custom btn-primary-custom w-100 py-2 justify-content-center" onclick="addProductToGrid()">
                    Thêm <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </div>

        <!-- Selected products table -->
        <h5 class="font-title fw-bold text-secondary mb-3"><i class="fa-solid fa-list-ol me-2"></i>Danh sách sản phẩm</h5>
        <div class="table-responsive mb-4">
            <table class="table table-custom" id="tblChiTiet">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Đơn vị tính</th>
                        <th style="width: 120px; text-align: center;">Số lượng</th>
                        <th style="width: 180px; text-align: right;">Đơn giá</th>
                        <th style="width: 180px; text-align: right;">Thành tiền</th>
                        <th style="width: 100px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tbodyChiTiet">
                    <tr id="trEmpty">
                        <td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm nào được chọn.</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end py-3">TỔNG CỘNG:</th>
                        <th class="text-end text-success fs-5 py-3 fw-bold" id="lblTongTien">0 VND</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="/PhieuXuat" class="btn-custom btn-secondary-custom">
                <i class="fa-solid fa-chevron-left"></i> Quay lại
            </a>
            <button type="submit" class="btn-custom btn-primary-custom">
                Lưu bản nháp <i class="fa-solid fa-floppy-disk"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var addedProducts = [];
        var currentStock = 0;

        function onKhoOrProductChange() {
            var selectKho = document.getElementById('selectKho');
            var selectSP = document.getElementById('selectSP');
            var maKho = selectKho.value;
            var selectedOptionSP = selectSP.options[selectSP.selectedIndex];
            var maSP = selectedOptionSP.value;

            if (maSP) {
                var gia = selectedOptionSP.getAttribute('data-gia');
                document.getElementById('inputDG').value = Math.round(gia);
            } else {
                document.getElementById('inputDG').value = 0;
            }

            if (maKho && maSP) {
                // Fetch real-time stock levels from server
                fetch(`/PhieuXuat/GetStockLevel?maSP=${maSP}&maKho=${maKho}`)
                    .then(response => response.json())
                    .then(data => {
                        currentStock = data.tonKho;
                        var lbl = document.getElementById('lblTonKho');
                        lbl.innerText = currentStock;
                        if (currentStock === 0) {
                            lbl.className = "badge bg-danger fs-6 py-2 px-3 d-block text-center";
                        } else if (currentStock < 10) {
                            lbl.className = "badge bg-warning text-dark fs-6 py-2 px-3 d-block text-center";
                        } else {
                            lbl.className = "badge bg-success fs-6 py-2 px-3 d-block text-center";
                        }
                    });
            } else {
                currentStock = 0;
                document.getElementById('lblTonKho').innerText = 0;
                document.getElementById('lblTonKho').className = "badge bg-secondary fs-6 py-2 px-3 d-block text-center";
            }
        }

        function addProductToGrid() {
            var selectKho = document.getElementById('selectKho');
            var select = document.getElementById('selectSP');
            var selectedOption = select.options[select.selectedIndex];
            
            if (!selectKho.value) {
                Swal.fire('Cảnh báo', 'Vui lòng chọn Kho xuất hàng trước.', 'warning');
                return;
            }
            
            var maSP = selectedOption.value;
            if (!maSP) {
                Swal.fire('Cảnh báo', 'Vui lòng chọn sản phẩm.', 'warning');
                return;
            }

            var tenSP = selectedOption.text.split(' (')[0];
            var donVi = selectedOption.getAttribute('data-dv');
            var soLuong = parseInt(document.getElementById('inputSL').value);
            var donGia = parseFloat(document.getElementById('inputDG').value);

            if (soLuong <= 0) {
                Swal.fire('Cảnh báo', 'Số lượng phải lớn hơn 0.', 'warning');
                return;
            }
            if (donGia < 0) {
                Swal.fire('Cảnh báo', 'Đơn giá không được âm.', 'warning');
                return;
            }

            // Exceeds stock warning message
            if (soLuong > currentStock) {
                Swal.fire({
                    title: 'Cảnh báo: Vượt quá tồn kho!',
                    text: `Số lượng xuất (${soLuong}) lớn hơn số tồn kho hiện tại (${currentStock}) trong kho này. Bạn vẫn có thể lưu bản Nháp, nhưng sẽ không thể Duyệt phiếu nếu không nhập thêm hàng!`,
                    icon: 'info',
                    confirmButtonText: 'Đã hiểu'
                });
            }

            if (addedProducts.includes(maSP)) {
                Swal.fire('Cảnh báo', 'Sản phẩm này đã có trong danh sách.', 'warning');
                return;
            }

            // Lock warehouse selection to prevent inconsistent states
            selectKho.disabled = true;

            var trEmpty = document.getElementById('trEmpty');
            if (trEmpty) {
                trEmpty.remove();
            }

            addedProducts.push(maSP);

            var tbody = document.getElementById('tbodyChiTiet');
            var tr = document.createElement('tr');
            tr.setAttribute('id', 'tr-' + maSP);

            var thanhTien = soLuong * donGia;

            tr.innerHTML = `
                <td class="fw-bold text-secondary">
                    ${maSP}
                    <input type="hidden" name="maSP" value="${maSP}" />
                </td>
                <td class="fw-bold text-primary">${tenSP}</td>
                <td>${donVi}</td>
                <td style="text-align: center;">
                    ${soLuong}
                    <input type="hidden" name="soLuong" value="${soLuong}" />
                </td>
                <td class="text-end fw-bold text-dark">
                    ${donGia.toLocaleString('vi-VN')} VND
                    <input type="hidden" name="donGia" value="${donGia}" />
                </td>
                <td class="text-end fw-bold text-success thanh-tien-val" data-val="${thanhTien}">
                    ${thanhTien.toLocaleString('vi-VN')} VND
                </td>
                <td style="text-align: center;">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeProductFromGrid('${maSP}')">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(tr);
            updateTongTien();

            // Reset inputs
            select.value = '';
            document.getElementById('inputSL').value = 1;
            document.getElementById('inputDG').value = 0;
            document.getElementById('lblTonKho').innerText = 0;
            document.getElementById('lblTonKho').className = "badge bg-secondary fs-6 py-2 px-3 d-block text-center";
            currentStock = 0;
        }

        function removeProductFromGrid(maSP) {
            document.getElementById('tr-' + maSP).remove();
            addedProducts = addedProducts.filter(item => item !== maSP);

            var tbody = document.getElementById('tbodyChiTiet');
            if (tbody.children.length === 0) {
                var tr = document.createElement('tr');
                tr.setAttribute('id', 'trEmpty');
                tr.innerHTML = `<td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm nào được chọn.</td>`;
                tbody.appendChild(tr);
                
                // Unlock warehouse select if list is empty
                document.getElementById('selectKho').disabled = false;
            }

            updateTongTien();
        }

        function updateTongTien() {
            var elements = document.getElementsByClassName('thanh-tien-val');
            var tongTien = 0;
            for (var i = 0; i < elements.length; i++) {
                tongTien += parseFloat(elements[i].getAttribute('data-val'));
            }
            document.getElementById('lblTongTien').innerText = tongTien.toLocaleString('vi-VN') + ' VND';
        }

        // Form submit handler validation
        document.getElementById('phieuXuatForm').addEventListener('submit', function (e) {
            if (addedProducts.length === 0) {
                e.preventDefault();
                Swal.fire('Cảnh báo', 'Vui lòng thêm ít nhất một sản phẩm vào phiếu.', 'warning');
            } else {
                document.getElementById('selectKho').disabled = false;
            }
        });
    </script>
}
