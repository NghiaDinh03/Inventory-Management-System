@model IMS.Web.Models.PhieuXuat
@{
    ViewData["Title"] = "Chi tiết phiếu xuất " + (Model.SoPhieu ?? "");
}

<div class="card-custom">
    <!-- Header phiếu -->
    <div class="card-title-custom border-bottom pb-3 mb-4">
        <div>
            <i class="fa-solid fa-file-invoice text-primary me-2"></i>
            <span>Chi tiết chứng từ xuất: <strong class="text-primary">@(Model.SoPhieu ?? "Phiếu Nháp")</strong></span>
        </div>
        <div>
            <span class="badge-custom @(Model.TrangThai == "ĐãDuyệt" ? "badge-status-duyet" : Model.TrangThai == "Nháp" ? "badge-status-nhap" : "badge-status-huy") fs-6 px-3 py-2">
                @Model.TrangThai
            </span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thông tin Master -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="fw-bold text-secondary text-xs" style="font-size: 11px;">KHO XUẤT HÀNG</div>
            <div class="text-dark fw-bold mt-1">@(Model.Kho?.TenKho ?? "N/A")</div>
            <div class="text-muted text-xs mt-1" style="font-size: 12px;">Địa chỉ: @Model.Kho?.DiaChi</div>
        </div>

        <div class="col-md-3">
            <div class="fw-bold text-secondary text-xs" style="font-size: 11px;">NGƯỜI NHẬN HÀNG</div>
            <div class="text-primary fw-bold mt-1">@(Model.NguoiNhan ?? "Không chỉ định")</div>
        </div>

        <div class="col-md-3">
            <div class="fw-bold text-secondary text-xs" style="font-size: 11px;">NGÀY LẬP & DUYỆT</div>
            <div class="text-dark mt-1" style="font-size: 14px;"><strong>Lập:</strong> @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</div>
            @if (Model.NgayDuyet.HasValue)
            {
                <div class="text-success mt-1" style="font-size: 14px;"><strong>Duyệt:</strong> @Model.NgayDuyet.Value.ToString("dd/MM/yyyy HH:mm")</div>
            }
        </div>

        <div class="col-md-3">
            <div class="fw-bold text-secondary text-xs" style="font-size: 11px;">NHÂN VIÊN LẬP</div>
            <div class="text-dark fw-bold mt-1">@(Model.NhanVien?.HoTen ?? "N/A")</div>
            <div class="text-muted text-xs mt-1" style="font-size: 12px;">Chức vụ: @Model.NhanVien?.ChucVu</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.GhiChu))
    {
        <div class="p-3 bg-light rounded border mb-4" style="font-size: 14px;">
            <strong>Ghi chú:</strong> @Model.GhiChu
        </div>
    }

    <hr />

    <!-- Danh sách chi tiết Detail -->
    <h5 class="font-title fw-bold text-secondary mb-3"><i class="fa-solid fa-list-ol me-2"></i>Danh sách sản phẩm xuất kho</h5>
    <div class="table-responsive mb-4">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã SP</th>
                    <th>Tên sản phẩm</th>
                    <th>Đơn vị tính</th>
                    <th style="width: 120px; text-align: center;">Số lượng</th>
                    <th style="width: 180px; text-align: right;">Đơn giá</th>
                    <th style="width: 180px; text-align: right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ChiTietPhieuXuats != null && Model.ChiTietPhieuXuats.Any())
                {
                    foreach (var ct in Model.ChiTietPhieuXuats)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">#@ct.MaSP</td>
                            <td class="fw-bold text-primary">@(ct.SanPham?.TenSP ?? "Sản phẩm không tồn tại")</td>
                            <td>@(ct.SanPham?.DonVi ?? "")</td>
                            <td style="text-align: center;" class="fw-bold">@ct.SoLuong</td>
                            <td class="text-end">@ct.DonGia.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-success">@ct.ThanhTien.ToString("N0") đ</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Phiếu xuất này không có chi tiết.</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end py-3">TỔNG TIỀN THANH TOÁN:</th>
                    <th class="text-end text-success fs-5 py-3 fw-bold">@Model.TongTien.ToString("N0") đ</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Nút thao tác -->
    <div class="d-flex justify-content-between">
        <a href="/PhieuXuat" class="btn-custom btn-secondary-custom">
            <i class="fa-solid fa-chevron-left"></i> Quay lại
        </a>

        <div class="d-flex gap-2">
            @if (Model.TrangThai == "Nháp")
            {
                <button type="button" class="btn-custom btn-secondary-custom text-danger" onclick="confirmHuy()">
                    Hủy phiếu <i class="fa-solid fa-trash-can"></i>
                </button>

                <!-- Nút Duyệt phiếu -->
                <form asp-action="Duyet" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaPX" />
                    <button type="submit" class="btn-custom btn-primary-custom" style="background: var(--success-gradient); box-shadow: 0 4px 14px rgba(16, 185, 129, 0.2);">
                        Duyệt phiếu xuất <i class="fa-solid fa-square-check"></i>
                    </button>
                </form>
            }
            else if (Model.TrangThai == "ĐãDuyệt")
            {
                <button type="button" class="btn-custom btn-secondary-custom text-danger" onclick="confirmHuy()">
                    Hủy phiếu (Hoàn tồn) <i class="fa-solid fa-ban"></i>
                </button>
            }
        </div>
    </div>
</div>

<!-- Form ẩn gửi yêu cầu hủy -->
<form id="huyForm" asp-action="Huy" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.MaPX" />
    <input type="hidden" name="lyDo" id="inputLyDo" />
</form>

@section Scripts {
    <script>
        function confirmHuy() {
            Swal.fire({
                title: 'Hủy phiếu xuất kho?',
                text: 'Nhập lý do hủy phiếu xuất này. Việc hủy phiếu sẽ tự động hoàn trả lại số lượng tồn kho tương ứng!',
                input: 'text',
                inputPlaceholder: 'Nhập lý do hủy phiếu...',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Hủy bỏ',
                inputValidator: (value) => {
                    if (!value) {
                        return 'Bạn phải điền lý do hủy phiếu!'
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('inputLyDo').value = result.value;
                    document.getElementById('huyForm').submit();
                }
            });
        }
    </script>
}
