@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    var isNghiepVuActive = controller == "PhieuNhap" || controller == "PhieuXuat" || controller == "TonKho";
    var isDanhMucActive = controller == "SanPham" || controller == "DanhMuc" || controller == "NhaCungCap" || controller == "Kho";
    var isNangCaoActive = controller == "Demo" || controller == "HeThong";
}

<div class="app-sidebar">
    <div class="sidebar-brand">
        <i class="fa-solid fa-boxes-stacked text-white"></i>
        <span>IMS Antigravity</span>
    </div>
    
    <div class="sidebar-menu">
        <!-- Dashboard Item -->
        <a href="/" class="menu-item @(controller == "Home" && action == "Index" ? "active" : "")">
            <i class="fa-solid fa-chart-line"></i>
            <span>Tổng quan</span>
        </a>

        <!-- Collapsible Group: Nghiệp vụ kho -->
        <div class="menu-group">
            <div class="menu-group-header @(isNghiepVuActive ? "active-header" : "")" 
                 data-bs-toggle="collapse" 
                 data-bs-target="#collapseNghiepVu" 
                 aria-expanded="@(isNghiepVuActive ? "true" : "false")" 
                 aria-controls="collapseNghiepVu">
                <i class="fa-solid fa-warehouse"></i>
                <span>Nghiệp vụ kho</span>
                <i class="fa-solid fa-chevron-down group-arrow"></i>
            </div>
            <div id="collapseNghiepVu" class="collapse @(isNghiepVuActive ? "show" : "")">
                <div class="menu-group-items">
                    <a href="/PhieuNhap" class="menu-item sub-item @(controller == "PhieuNhap" ? "active" : "")">
                        <i class="fa-solid fa-file-import"></i>
                        Phiếu Nhập Kho
                    </a>
                    <a href="/PhieuXuat" class="menu-item sub-item @(controller == "PhieuXuat" ? "active" : "")">
                        <i class="fa-solid fa-file-export"></i>
                        Phiếu Xuất Kho
                    </a>
                    <a href="/TonKho" class="menu-item sub-item @(controller == "TonKho" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        Báo cáo Tồn Kho
                    </a>
                </div>
            </div>
        </div>

        <!-- Collapsible Group: Danh mục hệ thống -->
        <div class="menu-group">
            <div class="menu-group-header @(isDanhMucActive ? "active-header" : "")" 
                 data-bs-toggle="collapse" 
                 data-bs-target="#collapseDanhMuc" 
                 aria-expanded="@(isDanhMucActive ? "true" : "false")" 
                 aria-controls="collapseDanhMuc">
                <i class="fa-solid fa-folder-open"></i>
                <span>Danh mục hệ thống</span>
                <i class="fa-solid fa-chevron-down group-arrow"></i>
            </div>
            <div id="collapseDanhMuc" class="collapse @(isDanhMucActive ? "show" : "")">
                <div class="menu-group-items">
                    <a href="/SanPham" class="menu-item sub-item @(controller == "SanPham" ? "active" : "")">
                        <i class="fa-solid fa-box"></i>
                        Sản phẩm
                    </a>
                    <a href="/DanhMuc" class="menu-item sub-item @(controller == "DanhMuc" ? "active" : "")">
                        <i class="fa-solid fa-tags"></i>
                        Danh mục
                    </a>
                    <a href="/NhaCungCap" class="menu-item sub-item @(controller == "NhaCungCap" ? "active" : "")">
                        <i class="fa-solid fa-truck-field"></i>
                        Nhà cung cấp
                    </a>
                    <a href="/Kho" class="menu-item sub-item @(controller == "Kho" ? "active" : "")">
                        <i class="fa-solid fa-map-location-dot"></i>
                        Kho hàng
                    </a>
                </div>
            </div>
        </div>

        <!-- Collapsible Group: Nâng cao & Hệ thống -->
        <div class="menu-group">
            <div class="menu-group-header @(isNangCaoActive ? "active-header" : "")" 
                 data-bs-toggle="collapse" 
                 data-bs-target="#collapseNangCao" 
                 aria-expanded="@(isNangCaoActive ? "true" : "false")" 
                 aria-controls="collapseNangCao">
                <i class="fa-solid fa-screwdriver-wrench"></i>
                <span>Nâng cao & Hệ thống</span>
                <i class="fa-solid fa-chevron-down group-arrow"></i>
            </div>
            <div id="collapseNangCao" class="collapse @(isNangCaoActive ? "show" : "")">
                <div class="menu-group-items">
                    <a href="/Demo" class="menu-item sub-item @(controller == "Demo" ? "active" : "")">
                        <i class="fa-solid fa-flask"></i>
                        Demo B1-B5 SP/Trigger
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/HeThong" class="menu-item sub-item @(controller == "HeThong" ? "active" : "")">
                            <i class="fa-solid fa-gears"></i>
                            Sao lưu & Phục hồi
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="sidebar-footer">
        <div class="d-flex align-items-center gap-2 mb-2 px-2 text-white">
            <div class="user-avatar">
                @(User.FindFirst(ClaimTypes.GivenName)?.Value?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <div class="overflow-hidden">
                <div class="text-truncate fw-bold text-sm" style="font-size: 13px;">
                    @User.FindFirst(ClaimTypes.GivenName)?.Value
                </div>
                <div class="text-truncate text-muted" style="font-size: 11px;">
                    @(User.IsInRole("Admin") ? "Quản trị viên" : "Thủ kho")
                </div>
            </div>
        </div>
        <a href="/TaiKhoan/DoiMatKhau" class="menu-item py-2">
            <i class="fa-solid fa-key"></i> Đổi mật khẩu
        </a>
        <a href="/TaiKhoan/Logout" class="menu-item py-2 text-danger">
            <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
        </a>
    </div>
</div>
