@model IMS.Web.Models.SanPham
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card-custom">
            <div class="card-title-custom">
                <span><i class="fa-solid fa-plus text-primary me-2"></i>Thêm sản phẩm mới</span>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <span>@error.ErrorMessage</span><br />
                    }
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="TenSP">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" asp-for="TenSP" class="form-control-custom w-100" placeholder="Nhập tên sản phẩm..." required />
                        <span asp-validation-for="TenSP" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="MaDanhMuc">Danh mục sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="MaDanhMuc" class="form-control-custom w-100" asp-items="ViewBag.DanhMucs" required>
                            <option value="">-- Chọn danh mục sản phẩm --</option>
                        </select>
                        <span asp-validation-for="MaDanhMuc" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom" asp-for="DonVi">Đơn vị tính <span class="text-danger">*</span></label>
                        <input type="text" asp-for="DonVi" class="form-control-custom w-100" placeholder="ví dụ: Cái, Chai, Hộp, Thùng..." required />
                        <span asp-validation-for="DonVi" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom" asp-for="MaVach">Mã vạch sản phẩm</label>
                        <input type="text" asp-for="MaVach" class="form-control-custom w-100" placeholder="Nhập mã vạch sản phẩm (EAN/UPC)..." />
                        <span asp-validation-for="MaVach" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom" asp-for="TonToiThieu">Hạn mức tồn tối thiểu</label>
                        <input type="number" asp-for="TonToiThieu" class="form-control-custom w-100" placeholder="Nhập mức cảnh báo tồn thấp..." min="0" />
                        <span asp-validation-for="TonToiThieu" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="GiaNhap">Giá nhập tham khảo <span class="text-danger">*</span></label>
                        <input type="number" asp-for="GiaNhap" class="form-control-custom w-100" placeholder="Nhập giá tiền nhập sản phẩm..." min="0" step="1000" required />
                        <span asp-validation-for="GiaNhap" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="GiaBan">Giá bán tham khảo <span class="text-danger">*</span></label>
                        <input type="number" asp-for="GiaBan" class="form-control-custom w-100" placeholder="Nhập giá tiền bán sản phẩm..." min="0" step="1000" required />
                        <span asp-validation-for="GiaBan" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom" asp-for="HinhAnh">Đường dẫn hình ảnh</label>
                    <input type="text" asp-for="HinhAnh" class="form-control-custom w-100" placeholder="Đường dẫn ảnh tĩnh (ví dụ: /images/products/logitech.jpg)..." />
                    <span asp-validation-for="HinhAnh" class="text-danger text-sm"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom" asp-for="MoTa">Mô tả sản phẩm</label>
                    <textarea asp-for="MoTa" rows="3" class="form-control-custom w-100" placeholder="Mô tả tóm tắt về sản phẩm này..."></textarea>
                    <span asp-validation-for="MoTa" class="text-danger text-sm"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom">Trạng thái kinh doanh</label>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="trangThaiSwitch" asp-for="TrangThai" checked>
                        <label class="form-check-label text-secondary" for="trangThaiSwitch" style="font-size: 14px;">Đang kinh doanh mặt hàng này</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/SanPham" class="btn-custom btn-secondary-custom">
                        <i class="fa-solid fa-chevron-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn-custom btn-primary-custom">
                        Lưu sản phẩm <i class="fa-solid fa-floppy-disk"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
