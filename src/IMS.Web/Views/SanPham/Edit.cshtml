@model IMS.Web.Models.SanPham
@{
    ViewData["Title"] = "Cập nhật sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-10">
        <div class="card-custom">
            <div class="card-title-custom">
                <span><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Sửa thông tin sản phẩm</span>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <span>@error.ErrorMessage</span><br />
                    }
                </div>
            }

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaSP" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="TenSP">Tên sản phẩm <span class="text-danger">*</span></label>
                        <input type="text" asp-for="TenSP" class="form-control-custom w-100" required />
                        <span asp-validation-for="TenSP" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="MaDanhMuc">Danh mục sản phẩm <span class="text-danger">*</span></label>
                        <select asp-for="MaDanhMuc" class="form-control-custom w-100" asp-items="ViewBag.DanhMucs" required>
                            <option value="">-- Chọn danh mục sản phẩm --</option>
                        </select>
                        <span asp-validation-for="MaDanhMuc" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label-custom" asp-for="DonVi">Đơn vị tính <span class="text-danger">*</span></label>
                        <input type="text" asp-for="DonVi" class="form-control-custom w-100" required />
                        <span asp-validation-for="DonVi" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label-custom" asp-for="TrongLuong">Trọng lượng (kg) <span class="text-danger">*</span></label>
                        <input type="number" asp-for="TrongLuong" class="form-control-custom w-100" min="0" step="0.001" required />
                        <span asp-validation-for="TrongLuong" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label-custom" asp-for="MaVach">Mã vạch</label>
                        <input type="text" asp-for="MaVach" class="form-control-custom w-100" />
                        <span asp-validation-for="MaVach" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label-custom" asp-for="TonToiThieu">Định mức tồn tối thiểu</label>
                        <input type="number" asp-for="TonToiThieu" class="form-control-custom w-100" min="0" />
                        <span asp-validation-for="TonToiThieu" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="GiaNhap">Giá nhập ước tính <span class="text-danger">*</span></label>
                        <input type="number" asp-for="GiaNhap" class="form-control-custom w-100" min="0" step="1000" required />
                        <span asp-validation-for="GiaNhap" class="text-danger text-sm"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label-custom" asp-for="GiaBan">Giá bán ước tính <span class="text-danger">*</span></label>
                        <input type="number" asp-for="GiaBan" class="form-control-custom w-100" min="0" step="1000" required />
                        <span asp-validation-for="GiaBan" class="text-danger text-sm"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom" asp-for="HinhAnh">Đường dẫn hình ảnh</label>
                    <input type="text" asp-for="HinhAnh" class="form-control-custom w-100" />
                    <span asp-validation-for="HinhAnh" class="text-danger text-sm"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label-custom" asp-for="MoTa">Mô tả sản phẩm</label>
                    <textarea asp-for="MoTa" rows="3" class="form-control-custom w-100"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger text-sm"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom">Trạng thái</label>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="trangThaiSwitch" asp-for="TrangThai">
                        <label class="form-check-label text-secondary" for="trangThaiSwitch" style="font-size: 14px;">Đang kinh doanh (Kích hoạt sản phẩm)</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/SanPham" class="btn-custom btn-secondary-custom">
                        <i class="fa-solid fa-chevron-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn-custom btn-primary-custom">
                        Cập nhật <i class="fa-solid fa-floppy-disk"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
