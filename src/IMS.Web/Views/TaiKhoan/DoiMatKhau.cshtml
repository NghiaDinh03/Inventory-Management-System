@model IMS.Web.Models.TaiKhoan

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-custom">
            <div class="card-title-custom">
                <span><i class="fa-solid fa-key text-primary me-2"></i>Thay đổi mật khẩu</span>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="DoiMatKhau" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label-custom" for="matKhauCu">Mật khẩu cũ</label>
                    <input type="password" name="matKhauCu" id="matKhauCu" class="form-control-custom w-100" required placeholder="Nhập mật khẩu hiện tại..." />
                </div>

                <div class="mb-3">
                    <label class="form-label-custom" for="matKhauMoi">Mật khẩu mới</label>
                    <input type="password" name="matKhauMoi" id="matKhauMoi" class="form-control-custom w-100" required placeholder="Nhập mật khẩu mới..." />
                    <small class="text-muted" style="font-size: 11px;">Mật khẩu nên chứa cả chữ, số và ký tự đặc biệt để an toàn.</small>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom" for="xacNhanMatKhau">Xác nhận mật khẩu mới</label>
                    <input type="password" name="xacNhanMatKhau" id="xacNhanMatKhau" class="form-control-custom w-100" required placeholder="Nhập lại mật khẩu mới..." />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/" class="btn-custom btn-secondary-custom">
                        <i class="fa-solid fa-chevron-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn-custom btn-primary-custom">
                        Lưu mật khẩu <i class="fa-solid fa-floppy-disk"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
