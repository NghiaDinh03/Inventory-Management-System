@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 text-center">
        <div class="card-custom py-5">
            <div class="mb-4">
                <i class="fa-solid fa-hand-sharp fa-circle-exclamation text-danger" style="font-size: 72px;"></i>
            </div>
            <h2 class="font-title fw-bold text-danger mb-3">TỪ CHỐI TRUY CẬP</h2>
            <p class="text-secondary mb-4 px-4">
