@model IMS.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<!-- Thống kê tổng quát (4 Cards) -->
<div class="row g-4 mb-4">
    <!-- Card 1: Tổng sản phẩm -->
    <div class="col-md-3">
        <div class="stat-card stat-info">
            <div class="stat-info-text">
                <span class="stat-label">TỔNG SẢN PHẨM</span>
                <div class="stat-value">@Model.ThongKe.TongSanPham.ToString("N0")</div>
            </div>
            <div class="stat-icon">
                <i class="fa-solid fa-box"></i>
            </div>
        </div>
    </div>

    <!-- Card 2: Tổng Nhà cung cấp -->
    <div class="col-md-3">
        <div class="stat-card stat-success">
            <div class="stat-info-text">
                <span class="stat-label">NHÀ CUNG CẤP</span>
                <div class="stat-value">@Model.ThongKe.TongNCC.ToString("N0")</div>
            </div>
            <div class="stat-icon">
                <i class="fa-solid fa-truck-field"></i>
            </div>
        </div>
    </div>

    <!-- Card 3: Tổng Kho hàng -->
    <div class="col-md-3">
        <div class="stat-card stat-warning">
            <div class="stat-info-text">
                <span class="stat-label">KHO CHỨA HÀNG</span>
                <div class="stat-value">@Model.ThongKe.TongKho.ToString("N0")</div>
            </div>
            <div class="stat-icon">
                <i class="fa-solid fa-map-location-dot"></i>
            </div>
        </div>
    </div>

    <!-- Card 4: Tổng giá trị tồn -->
    <div class="col-md-3">
        <div class="stat-card stat-danger">
            <div class="stat-info-text">
                <span class="stat-label">GIÁ TRỊ TỒN KHO</span>
                <div class="stat-value" style="font-size: 20px; font-weight: 800; margin-top: 5px;">
                    @Model.ThongKe.TongGiaTriTon.ToString("N0") đ
                </div>
            </div>
            <div class="stat-icon">
                <i class="fa-solid fa-coins"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái (8 cột): Biểu đồ + Phiếu gần đây -->
    <div class="col-lg-8">
        <!-- Biểu đồ Nhập/Xuất hàng ngày -->
        <div class="card-custom">
            <div class="card-title-custom">
                <span><i class="fa-solid fa-chart-simple text-primary me-2"></i>Xu hướng nhập xuất hàng tồn kho</span>
            </div>
            <div style="height: 300px; position: relative;">
                <canvas id="chartNhapXuat"></canvas>
            </div>
        </div>

        <!-- 10 phiếu nhập/xuất gần đây nhất -->
        <div class="card-custom">
            <div class="card-title-custom">
                <span><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Chứng từ giao dịch gần đây</span>
            </div>
            <div class="table-responsive">
                <table class="table table-custom table-hover">
                    <thead>
                        <tr>
                            <th>Số phiếu</th>
                            <th>Loại phiếu</th>
                            <th>Ngày lập</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Người lập</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PhieuGanDay != null && Model.PhieuGanDay.Any())
                        {
                            foreach (var phieu in Model.PhieuGanDay)
                            {
                                <tr>
                                    <td class="fw-bold">@phieu.SoPhieu</td>
                                    <td>
                                        <span class="badge-custom @(phieu.LoaiPhieu == "Nhập" ? "badge-nhap" : "badge-xuat")">
                                            <i class="fa-solid @(phieu.LoaiPhieu == "Nhập" ? "fa-arrow-down-long" : "fa-arrow-up-long")"></i>
                                            @phieu.LoaiPhieu
                                        </span>
                                    </td>
                                    <td>@phieu.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold">@phieu.TongTien.ToString("N0") đ</td>
                                    <td>
                                        <span class="badge-custom @(phieu.TrangThai == "ĐãDuyệt" ? "badge-status-duyet" : phieu.TrangThai == "Nháp" ? "badge-status-nhap" : "badge-status-huy")">
                                            @phieu.TrangThai
                                        </span>
                                    </td>
                                    <td>@phieu.NguoiLap</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Chưa có giao dịch nhập xuất nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cột phải (4 cột): Cảnh báo tồn kho + Phiếu chưa duyệt -->
    <div class="col-lg-4">
        <!-- Hộp Phiếu Chưa Duyệt -->
        <div class="card-custom bg-gradient-custom mb-4" style="background: linear-gradient(135deg, #4f46e5 0%, #312e81 100%); color: white;">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-hourglass-half me-2"></i>Công việc chờ duyệt</h5>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Phiếu nhập kho chưa duyệt:</span>
                <span class="badge bg-warning text-dark fw-bold px-3 py-2" style="font-size: 14px;">
                    @Model.ThongKe.PhieuNhapChuaDuyet
                </span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span>Phiếu xuất kho chưa duyệt:</span>
                <span class="badge bg-warning text-dark fw-bold px-3 py-2" style="font-size: 14px;">
                    @Model.ThongKe.PhieuXuatChuaDuyet
                </span>
            </div>
            <div class="d-grid gap-2">
                <a href="/PhieuNhap" class="btn btn-light btn-sm fw-bold">
                    Xem danh sách phiếu nhập <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
                <a href="/PhieuXuat" class="btn btn-outline-light btn-sm fw-bold">
                    Xem danh sách phiếu xuất <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <!-- Cảnh báo sản phẩm tồn kho thấp -->
        <div class="card-custom">
            <div class="card-title-custom">
                <span>
                    <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                    Cảnh báo tồn kho thấp
                </span>
                @if (Model.SpDuoiTonToiThieu.Any())
                {
                    <span class="badge bg-danger rounded-pill">@Model.SpDuoiTonToiThieu.Count</span>
                }
            </div>
            
            <div class="d-flex flex-column gap-3" style="max-height: 380px; overflow-y: auto; padding-right: 4px;">
                @if (Model.SpDuoiTonToiThieu != null && Model.SpDuoiTonToiThieu.Any())
                {
                    foreach (var item in Model.SpDuoiTonToiThieu)
                    {
                        <div class="p-3 rounded border border-danger-subtle bg-danger-subtle bg-opacity-10 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-sm" style="font-size: 13px; color: #7f1d1d;">@item.TenSP</div>
                                <div class="text-muted text-xs" style="font-size: 11px;">
                                    Kho: @item.TenKho | Đơn vị: @item.DonVi
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="text-danger fw-bold fs-5">@item.SoLuong</div>
                                <div class="text-muted text-xs" style="font-size: 10px;">Yêu cầu: @item.TonToiThieu</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fa-solid fa-circle-check text-success fs-3 mb-2"></i>
                        <div>Không có sản phẩm nào dưới mức tối thiểu.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Lấy dữ liệu từ Model truyền vào JS cho biểu đồ
            var labels = [];
            var dataNhap = [];
            var dataXuat = [];

            @foreach (var item in Model.NhapXuatTheoNgay.OrderBy(n => n.Ngay))
            {
                <text>
                    labels.push('@item.Ngay.ToString("dd/MM")');
                    dataNhap.push(@item.TongNhap);
                    dataXuat.push(@item.TongXuat);
                </text>
            }

            // Vẽ biểu đồ Chart.js
            var ctx = document.getElementById('chartNhapXuat').getContext('2d');
            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Số lượng Nhập kho',
                            data: dataNhap,
                            backgroundColor: 'rgba(79, 70, 229, 0.85)',
                            borderColor: 'rgba(79, 70, 229, 1)',
                            borderWidth: 1,
                            borderRadius: 6
                        },
                        {
                            label: 'Số lượng Xuất kho',
                            data: dataXuat,
                            backgroundColor: 'rgba(6, 182, 212, 0.85)',
                            borderColor: 'rgba(6, 182, 212, 1)',
                            borderWidth: 1,
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                font: {
                                    family: 'Plus Jakarta Sans',
                                    weight: 600
                                },
                                padding: 20
                            }
                        },
                        tooltip: {
                            padding: 12,
                            cornerRadius: 8,
                            titleFont: {
                                family: 'Outfit',
                                size: 14,
                                weight: 'bold'
                            },
                            bodyFont: {
                                family: 'Plus Jakarta Sans',
                                size: 13
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#f1f5f9'
                            },
                            ticks: {
                                font: {
                                    family: 'Plus Jakarta Sans'
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    family: 'Plus Jakarta Sans'
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
