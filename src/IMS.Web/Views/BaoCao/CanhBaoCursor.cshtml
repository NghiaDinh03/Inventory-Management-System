@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Cảnh báo tồn kho thấp (Cursor)";
}

<div class="alert alert-warning border-warning-subtle bg-warning-subtle text-warning-emphasis p-3 rounded mb-4">
    <div class="d-flex align-items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation fs-3"></i>
        <div>
            <h5 class="fw-bold mb-1">Màn hình Báo cáo Cursor của Hệ thống</h5>
            <p class="mb-0 text-sm" style="font-size: 13px;">
                Dữ liệu dưới đây được sinh ra bằng cách chạy **Cursor trong SQL Server** (thủ tục <code>sp_CursorCanhBaoTon</code>). 
                Cursor duyệt qua từng dòng trong bảng Tồn Kho, so sánh với hạn mức tối thiểu của sản phẩm, in thông báo ra tab Messages và đẩy dữ liệu về giao diện Web.
            </p>
        </div>
    </div>
</div>

<div class="card-custom">
    <div class="card-title-custom">
        <span><i class="fa-solid fa-laptop-code text-primary me-2"></i>Thông tin cảnh báo sinh từ Cursor</span>
        <span class="badge bg-danger">Số lượng cảnh báo: @Model.Rows.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover datatable-custom">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã SP</th>
                    <th>Tên sản phẩm</th>
                    <th>Kho hàng</th>
                    <th style="text-align: center;">Tồn hiện tại</th>
                    <th style="text-align: center;">Hạn mức tối thiểu</th>
                    <th>Thông tin chi tiết cảnh báo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">#@row["MaSP"]</td>
                            <td class="fw-bold text-primary">@row["TenSP"]</td>
                            <td class="fw-bold text-secondary">@row["TenKho"]</td>
                            <td style="text-align: center;" class="fw-bold text-danger">@row["SoLuong"]</td>
                            <td style="text-align: center;"><span class="badge bg-secondary">@row["TonToiThieu"]</span></td>
                            <td class="text-danger fw-semibold" style="font-size: 13px;">
                                <i class="fa-solid fa-bell me-1"></i> @row["CanhBao"]
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="fa-solid fa-circle-check text-success fs-3 mb-2"></i>
                            <div>Tuyệt vời! Không có sản phẩm nào dưới mức tồn tối thiểu.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
