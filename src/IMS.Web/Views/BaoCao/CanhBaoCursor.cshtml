@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Cảnh báo tồn kho bằng Cursor";
}

<div class="alert alert-warning border-warning-subtle bg-warning-subtle text-warning-emphasis p-3 rounded mb-4">
    <div class="d-flex align-items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation fs-3"></i>
        <div>
            <h5 class="fw-bold mb-1">Báo cáo tồn kho bằng con trỏ Cursor</h5>
            <p class="mb-0 text-sm" style="font-size: 13px;">
                Dữ liệu dưới đây được tạo ra bằng cách chạy con trỏ **Cursor trong SQL Server** (thủ tục <code>sp_CursorCanhBaoTon</code>). 
                Con trỏ duyệt qua từng sản phẩm trong bảng tồn kho, so sánh với định mức tối thiểu, in thông báo ra tab Messages và trả dữ liệu về ứng dụng web.
            </p>
        </div>
    </div>
</div>

<div class="card-custom">
    <div class="card-title-custom">
        <span><i class="fa-solid fa-laptop-code text-primary me-2"></i>Cảnh báo sinh ra từ Cursor</span>
        <span class="badge bg-danger">Số lượng cảnh báo: @Model.Rows.Count</span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover datatable-custom">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã SP</th>
                    <th>Tên sản phẩm</th>
                    <th>Kho hàng</th>
                    <th style="text-align: center;">Số lượng tồn</th>
                    <th style="text-align: center;">Tồn tối thiểu</th>
                    <th>Chi tiết cảnh báo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">#@row["MaSP"]</td>
                            <td class="fw-bold text-primary">@row["TenSP"]</td>
                            <td class="fw-bold text-secondary">@row["TenKho"]</td>
                            <td style="text-align: center;" class="fw-bold text-danger">@row["SoLuong"]</td>
                            <td style="text-align: center;"><span class="badge bg-secondary">@row["TonToiThieu"]</span></td>
                            <td class="text-danger fw-semibold" style="font-size: 13px;">
                                <i class="fa-solid fa-bell me-1"></i> @row["CanhBao"]
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="fa-solid fa-circle-check text-success fs-3 mb-2"></i>
                            <div>Tuyệt vời! Không có sản phẩm nào ở dưới mức tồn tối thiểu.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
