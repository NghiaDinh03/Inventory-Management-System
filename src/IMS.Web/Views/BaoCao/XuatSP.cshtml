@using System.Data
@model DataTable
@{
    ViewData["Title"] = "Báo cáo xuất hàng theo sản phẩm";
}

<!-- Bộ lọc -->
<div class="card-custom mb-4">
    <div class="card-title-custom">
        <span><i class="fa-solid fa-filter text-primary me-2"></i>Lọc dữ liệu xuất hàng</span>
    </div>
    <form method="get" action="/BaoCao/XuatSP" class="row align-items-end g-3">
        <div class="col-md-4">
            <label class="form-label-custom">Chọn sản phẩm</label>
            <select name="maSP" class="form-control-custom w-100" asp-items="ViewBag.SanPhams">
                <option value="">-- Tất cả sản phẩm --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label-custom">Từ ngày</label>
            <input type="date" name="tuNgay" class="form-control-custom w-100" value="@ViewBag.TuNgay" required />
        </div>
        <div class="col-md-3">
            <label class="form-label-custom">Đến ngày</label>
            <input type="date" name="denNgay" class="form-control-custom w-100" value="@ViewBag.DenNgay" required />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn-custom btn-primary-custom w-100 py-2 justify-content-center">
                Filter <i class="fa-solid fa-magnifying-glass"></i>
            </button>
        </div>
    </form>
</div>

<!-- Bảng hiển thị -->
<div class="card-custom">
    <div class="card-title-custom">
        <span>
            <i class="fa-solid fa-list-ol text-primary me-2"></i>
            Chi tiết xuất kho từ <strong>@DateTime.Parse(ViewBag.TuNgay).ToString("dd/MM/yyyy")</strong> đến <strong>@DateTime.Parse(ViewBag.DenNgay).ToString("dd/MM/yyyy")</strong>
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover datatable-custom">
            <thead>
                <tr>
                    <th>Số phiếu</th>
                    <th>Ngày duyệt</th>
                    <th>Kho xuất</th>
                    <th>Tên sản phẩm</th>
                    <th style="text-align: center;">Số lượng</th>
                    <th style="text-align: right;">Đơn giá</th>
                    <th style="text-align: right;">Thành tiền</th>
                    <th>Người nhận</th>
                    <th>Người lập</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Rows.Count > 0)
                {
                    foreach (DataRow row in Model.Rows)
                    {
                        var thanhTien = Convert.ToDecimal(row["ThanhTien"]);
                        <tr>
                            <td class="fw-bold text-dark">@row["SoPhieu"]</td>
                            <td>@Convert.ToDateTime(row["NgayDuyet"]).ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-secondary">@row["TenKho"]</td>
                            <td class="fw-bold text-primary">@row["TenSP"]</td>
                            <td style="text-align: center;" class="fw-bold">@Convert.ToInt32(row["SoLuong"]).ToString("N0")</td>
                            <td class="text-end">@Convert.ToDecimal(row["DonGia"]).ToString("N0") đ</td>
                            <td class="text-end fw-bold text-success">@thanhTien.ToString("N0") đ</td>
                            <td>@row["NguoiNhan"]</td>
                            <td>@row["NguoiLap"]</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">Không có dữ liệu trong khoảng thời gian đã chọn.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
