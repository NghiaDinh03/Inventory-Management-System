@{
    ViewData["Title"] = "Lập phiếu nhập kho";
    var sanPhams = ViewBag.SanPhams as List<IMS.Web.Models.SanPham> ?? new List<IMS.Web.Models.SanPham>();
}

<div class="card-custom">
    <div class="card-title-custom">
        <span><i class="fa-solid fa-file-import text-primary me-2"></i>Lập phiếu nhập kho mới (Nháp)</span>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form id="phieuNhapForm" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        
        <!-- Thông tin chung -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <label class="form-label-custom">Nhà cung cấp <span class="text-danger">*</span></label>
                <select name="maNCC" class="form-control-custom w-100" asp-items="ViewBag.NhaCungCaps" required>
                    <option value="">-- Chọn nhà cung cấp --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label-custom">Kho nhập hàng <span class="text-danger">*</span></label>
                <select name="maKho" class="form-control-custom w-100" asp-items="ViewBag.Khos" required>
                    <option value="">-- Chọn kho nhận hàng --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label-custom">Ghi chú</label>
                <input type="text" name="ghiChu" class="form-control-custom w-100" placeholder="Ghi chú thêm về phiếu nhập này..." />
            </div>
        </div>

        <hr />

        <!-- Form chọn sản phẩm thêm vào chi tiết -->
        <h5 class="font-title fw-bold text-secondary mb-3"><i class="fa-solid fa-cart-plus me-2"></i>Thêm sản phẩm nhập kho</h5>
        <div class="row g-3 align-items-end mb-4 bg-light p-3 rounded border">
            <div class="col-md-5">
                <label class="form-label-custom">Sản phẩm</label>
                <select id="selectSP" class="form-control-custom w-100" onchange="onProductSelectChange()">
                    <option value="">-- Chọn sản phẩm --</option>
                    @foreach (var sp in sanPhams)
                    {
                        <option value="@sp.MaSP" data-gia="@sp.GiaNhap" data-dv="@sp.DonVi">@sp.TenSP (@sp.DonVi)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label-custom">Số lượng</label>
                <input type="number" id="inputSL" class="form-control-custom w-100" min="1" value="1" />
            </div>
            <div class="col-md-3">
                <label class="form-label-custom">Đơn giá nhập</label>
                <div class="input-group">
                    <input type="number" id="inputDG" class="form-control-custom w-100" min="0" value="0" step="500" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn-custom btn-primary-custom w-100 py-2 justify-content-center" onclick="addProductToGrid()">
                    Thêm <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </div>

        <!-- Bảng hiển thị các chi tiết đã thêm -->
        <h5 class="font-title fw-bold text-secondary mb-3"><i class="fa-solid fa-list-ol me-2"></i>Danh sách mặt hàng nhập</h5>
        <div class="table-responsive mb-4">
            <table class="table table-custom" id="tblChiTiet">
                <thead>
                    <tr>
                        <th style="width: 80px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>ĐVT</th>
                        <th style="width: 120px; text-align: center;">Số lượng</th>
                        <th style="width: 180px; text-align: right;">Đơn giá</th>
                        <th style="width: 180px; text-align: right;">Thành tiền</th>
                        <th style="width: 100px; text-align: center;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tbodyChiTiet">
                    <!-- Các dòng sản phẩm được add động vào đây -->
                    <tr id="trEmpty">
                        <td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm nào được chọn.</td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="5" class="text-end py-3">TỔNG CỘNG TIỀN PHIẾU:</th>
                        <th class="text-end text-success fs-5 py-3 fw-bold" id="lblTongTien">0 đ</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a href="/PhieuNhap" class="btn-custom btn-secondary-custom">
                <i class="fa-solid fa-chevron-left"></i> Quay lại
            </a>
            <button type="submit" class="btn-custom btn-primary-custom">
                Lập phiếu nháp <i class="fa-solid fa-floppy-disk"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var addedProducts = [];

        function onProductSelectChange() {
            var select = document.getElementById('selectSP');
            var selectedOption = select.options[select.selectedIndex];
            if (selectedOption.value) {
                var gia = selectedOption.getAttribute('data-gia');
                document.getElementById('inputDG').value = Math.round(gia);
            } else {
                document.getElementById('inputDG').value = 0;
            }
        }

        function addProductToGrid() {
            var select = document.getElementById('selectSP');
            var selectedOption = select.options[select.selectedIndex];
            var maSP = selectedOption.value;
            
            if (!maSP) {
                Swal.fire('Cảnh báo', 'Vui lòng chọn một sản phẩm.', 'warning');
                return;
            }

            var tenSP = selectedOption.text.split(' (')[0];
            var donVi = selectedOption.getAttribute('data-dv');
            var soLuong = parseInt(document.getElementById('inputSL').value);
            var donGia = parseFloat(document.getElementById('inputDG').value);

            if (soLuong <= 0) {
                Swal.fire('Cảnh báo', 'Số lượng phải lớn hơn 0.', 'warning');
                return;
            }
            if (donGia < 0) {
                Swal.fire('Cảnh báo', 'Đơn giá không được âm.', 'warning');
                return;
            }

            // Kiểm tra trùng lặp
            if (addedProducts.includes(maSP)) {
                Swal.fire('Cảnh báo', 'Sản phẩm này đã có trong danh sách. Hãy xóa dòng cũ nếu muốn cập nhật lại.', 'warning');
                return;
            }

            // Xóa dòng rỗng
            var trEmpty = document.getElementById('trEmpty');
            if (trEmpty) {
                trEmpty.remove();
            }

            addedProducts.push(maSP);

            var tbody = document.getElementById('tbodyChiTiet');
            var tr = document.createElement('tr');
            tr.setAttribute('id', 'tr-' + maSP);

            var thanhTien = soLuong * donGia;

            tr.innerHTML = `
                <td class="fw-bold text-secondary">
                    ${maSP}
                    <input type="hidden" name="maSP" value="${maSP}" />
                </td>
                <td class="fw-bold text-primary">${tenSP}</td>
                <td>${donVi}</td>
                <td style="text-align: center;">
                    ${soLuong}
                    <input type="hidden" name="soLuong" value="${soLuong}" />
                </td>
                <td class="text-end fw-bold text-dark">
                    ${donGia.toLocaleString('vi-VN')} đ
                    <input type="hidden" name="donGia" value="${donGia}" />
                </td>
                <td class="text-end fw-bold text-success thanh-tien-val" data-val="${thanhTien}">
                    ${thanhTien.toLocaleString('vi-VN')} đ
                </td>
                <td style="text-align: center;">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeProductFromGrid('${maSP}')">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(tr);

            // Cập nhật tổng tiền
            updateTongTien();

            // Reset inputs
            select.value = '';
            document.getElementById('inputSL').value = 1;
            document.getElementById('inputDG').value = 0;
        }

        function removeProductFromGrid(maSP) {
            document.getElementById('tr-' + maSP).remove();
            
            // Xóa khỏi mảng quản lý trùng
            addedProducts = addedProducts.filter(item => item !== maSP);

            // Nếu rỗng thì thêm lại trEmpty
            var tbody = document.getElementById('tbodyChiTiet');
            if (tbody.children.length === 0) {
                var tr = document.createElement('tr');
                tr.setAttribute('id', 'trEmpty');
                tr.innerHTML = `<td colspan="7" class="text-center text-muted py-4">Chưa có sản phẩm nào được chọn.</td>`;
                tbody.appendChild(tr);
            }

            updateTongTien();
        }

        function updateTongTien() {
            var elements = document.getElementsByClassName('thanh-tien-val');
            var tongTien = 0;
            for (var i = 0; i < elements.length; i++) {
                tongTien += parseFloat(elements[i].getAttribute('data-val'));
            }
            document.getElementById('lblTongTien').innerText = tongTien.toLocaleString('vi-VN') + ' đ';
        }

        // Validate form khi submit
        document.getElementById('phieuNhapForm').addEventListener('submit', function (e) {
            if (addedProducts.length === 0) {
                e.preventDefault();
                Swal.fire('Cảnh báo', 'Vui lòng thêm ít nhất một sản phẩm vào phiếu nhập trước khi lưu.', 'warning');
            }
        });
    </script>
}
